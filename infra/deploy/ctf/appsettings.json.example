{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=db;Port=5432;Database=gzctf;Username=postgres;Password=REPLACE_WITH_EXISTING_POSTGRES_PASSWORD"
  },
  "EmailConfig": {
    "SenderAddress": "",
    "SenderName": "",
    "UserName": "",
    "Password": "",
    "Smtp": {
      "Host": "localhost",
      "Port": 587
    }
  },
  "XorKey": "REPLACE_WITH_EXISTING_XOR_KEY",
  "ContainerProvider": {
    "Type": "Docker",
    "PortMappingType": "Default",
    "EnableTrafficCapture": false,
    "PublicEntry": "ctf.nkisa.com",
    "DockerConfig": {
      "Uri": "unix:///var/run/docker.sock"
    }
  },
  "CaptchaConfig": {
    "Provider": "HashPow",
    "HashPow": {
      "Difficulty": 18
    }
  },
  "DisableRateLimit": false,
  "ForwardedOptions": {
    "ForwardedHeaders": 7,
    "ForwardLimit": 1,
    "KnownProxies": [
      "172.19.0.1"
    ]
  }
}
